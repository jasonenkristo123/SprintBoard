    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.0.0",
    "vite": ">=8.0.12"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "oxfmt --check .",
    "check": "node node_modules/@typescript/native/bin/tsc",
