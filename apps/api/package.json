{
    "name": "@sprintboard/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "typecheck": "tsc --noEmit",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "bunx drizzle-kit migrate",
        "db:push": "bunx drizzle-kit push"
    },
    "dependencies": {
        "@elysia/cors": "^1.4.3",
        "@elysiajs/cors": "^1.4.3",
        "@elysiajs/swagger": "^1.3.1",
        "better-auth": "^1.7.20",
        "drizzle-orm": "^0.45.4",
        "drizzle-typebox": "^0.3.3",
        "elysia": "^1.4.31",
        "nodemailer": "^10.5.0",
        "postgres": "^4.1.0"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/nodemailer": "^8.0.2",
        "drizzle-kit": "^0.31.11",
        "typescript": "^6.0.3"
    }
}